<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Name}}</title>
    <link rel="stylesheet" href="/resources/style.css">
</head>
<body class="detail-page">
    <div class="detail-container">
        <div class="detail-header">
            <div class="detail-year">ГОД НАЧАЛА: {{.Year}}г.</div>
            <a href="/anomalies" class="close-button">
                <img src="http://127.0.0.1:9000/images/img/close-b.jpg" alt="Закрыть">
            </a>
        </div>
        
        <h1 class="detail-title">{{.Name}}</h1>
        
        <img src="{{.Image}}" alt="{{.Name}}" class="detail-image">
        
        <div class="detail-info-block">
            {{.Description}}
        </div>

        <form method="POST" action="/tree/add" class="add-to-tree-form">
            <input type="hidden" name="anomaly_id" value="{{.ID}}">
            <div class="form-group">
                <label for="anomalous_rings">Номера аномальных колец:</label>
                <input type="text" name="anomalous_rings" id="anomalous_rings" required>
            </div>
            <div class="form-group">
                <label for="calculated_year">Рассчитанный год:</label>
                <input type="number" name="calculated_year" id="calculated_year" required>
            </div>
            <button type="submit" class="add-to-tree-btn">Добавить в дерево</button>
        </form>
    </div>
</body>
</html>