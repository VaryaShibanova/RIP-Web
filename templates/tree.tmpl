<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Заявка на исследование</title>
    <link rel="stylesheet" href="/resources/style.css">
</head>
<body>
    <div class="header-nav">
        <a href="/anomalies" class="header-nav-link">Аномальные паттерны</a>
    </div>

    <div class="container">

        <!-- Общая информация о заявке -->
        <div class="request-general-info">
            <div class="general-info-card">
                <div class="info-header">
                    <span class="info-label">ОПИСАНИЕ НАХОДКИ</span>
                </div>
                <div class="info-value-input">
                    {{if .tree}}{{.tree.Description}}{{else}}Не указано{{end}}
                </div>
            </div>
            
            <div class="general-info-card">
                <div class="info-header">
                    <span class="info-label">ЧИСЛО ВСЕХ КОЛЕЦ</span>
                </div>
                <div class="info-value-input">
                    {{if .tree}}{{.tree.TotalRings}}{{else}}0{{end}}
                </div>
            </div>
            
            <div class="general-info-card">
                <div class="info-header">
                    <span class="info-label">ИТОГОВЫЙ ГОД</span>
                </div>
                <div class="info-value-input">
                    {{if .tree}}{{.tree.FinalYear}}{{else}}0{{end}} г.
                </div>
            </div>
        </div>

        <!-- Заголовки столбцов - БЕЗ INLINE СТИЛЕЙ -->
        <div class="requests-header">
            <div class="requests-column">АНОМАЛИЯ</div>
            <div class="requests-column">НОМЕРА АНОМАЛЬНЫХ КОЛЕЦ</div>
            <div class="requests-column">РАСЧИТАННЫЙ ГОД</div>
        </div>

        <!-- Таблица с заявками -->
        <div class="requests-container">
            {{if .treeItems}}
                {{range .treeItems}}
                <div class="request-item">
                    <div class="request-info-section anomaly-section">
                        <div class="request-image">
                            <img src="{{.Anomaly.Image}}" alt="{{.Anomaly.Name}}">
                        </div>
                        <div class="anomaly-name">
                            {{.Anomaly.Name}}
                        </div>
                    </div>
                    <div class="request-info-section">
                        <div class="info-value rings-value">
                            {{.AnomalousRings}}
                        </div>
                    </div>
                    <div class="request-info-section">
                        <div class="info-value year-value">
                            {{.CalculatedYear}} г.
                        </div>
                    </div>
                </div>
                {{end}}
            {{else}}
                <div class="no-items">Нет аномалий в заявке</div>
            {{end}}
        </div>

        <div class="requests-count">
            Количество аномалий в заявке: {{if .treeItems}}{{len .treeItems}}{{else}}0{{end}}
        </div>

        {{if .treeItems}}
        <div class="tree-actions">
            <form method="POST" action="/tree/delete" onsubmit="return confirm('Вы уверены, что хотите удалить заявку?')">
                <input type="hidden" name="tree_id" value="{{.tree.ID}}">
                <button type="submit" class="delete-tree-btn">Удалить заявку</button>
            </form>
        </div>
        {{end}}
    </div>
</body>
</html>